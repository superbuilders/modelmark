{
    "name": "modelmark",
    "version": "0.1.4",
    "description": "Marks each git commit with the coding agent, model and effort level that made it",
    "keywords": [
        "git",
        "commit",
        "trailer",
        "ai",
        "coding-agent",
        "claude-code",
        "codex",
        "pi"
    ],
    "homepage": "https://github.com/superbuilders/modelmark#readme",
    "bugs": {
        "url": "https://github.com/superbuilders/modelmark/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/superbuilders/modelmark.git"
    },
    "license": "MIT",
    "type": "module",
    "bin": {
        "modelmark": "src/cli.ts"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "tested-versions.json"
    ],
    "scripts": {
        "bump": "bumpp --commit 'Release v%s' --tag 'v%s'",
        "check": "bun scripts/check",
        "knip": "knip --reporter compact --treat-config-hints-as-errors",
        "prepare": "husky",
        "test": "bun --bun vitest run",
        "typecheck": "tsgo --project tsconfig.json"
    },
    "dependencies": {
        "commander": "^15.0.0"
    },
    "devDependencies": {
        "@secretlint/secretlint-rule-no-dotenv": "^13.0.6",
        "@secretlint/secretlint-rule-pattern": "^13.0.6",
        "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.6.3",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitest/coverage-istanbul": "4.1.11",
        "bumpp": "^12.3.0",
        "bun-types": "~1.3.14",
        "colorette": "^2.0.20",
        "eslint-plugin-jsdoc": "^64.5.4",
        "husky": "^9.1.7",
        "knip": "^6.38.0",
        "lint-staged": "^17.6.0",
        "oxfmt": "0.54.0",
        "oxlint": "1.86.0",
        "oxlint-tsgolint": "7.0.2003",
        "secretlint": "^13.0.6",
        "sort-package-json": "^4.0.0",
        "vitest": "4.1.11"
    },
    "packageManager": "bun@1.3.13",
    "engines": {
        "bun": ">=1.3"
    }
}
