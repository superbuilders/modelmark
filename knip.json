{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "exclude": ["duplicates"],
    "ignoreExportsUsedInFile": { "interface": true, "type": true },
    "ignoreDependencies": ["@secretlint/.+"],
    "entry": ["scripts/*/index.ts", "*.config.ts", ".oxlint/plugins/**/*.mjs"],
    "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",

        "*.ts",
        ".oxlint/plugins/**/*.mjs"
    ]
}
